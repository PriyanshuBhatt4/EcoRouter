{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.3-flash-free",
  "default_agent": "build",
  "subagent_depth": 1,
  "snapshot": true,
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git stash*": "deny",
      "git commit*": "deny",
      "git add*": "deny",
      "git branch -D*": "deny",
      "alembic upgrade*": "deny",
      "npm publish*": "deny",
      "eas submit*": "deny"
    }
  }
}